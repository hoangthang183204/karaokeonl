# PostgreSQL
DATABASE_URL=postgresql://karaoke:karaoke@localhost:5432/karaoke?schema=public

# JWT — đổi trước khi triển khai thật
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=3001
WEB_ORIGIN=http://localhost:3000

# YouTube Data API v3. Để trống thì chỉ dùng dán link (oEmbed), không có tìm kiếm.
YOUTUBE_API_KEY=

# LiveKit. Để trống thì voice báo thiếu cấu hình, không giả lập phòng thoại.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Public URLs cho browser
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:3001
