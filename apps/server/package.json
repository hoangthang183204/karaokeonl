{
  "name": "@karaoke/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/with-root-env.mjs --allow-placeholder npx prisma generate",
    "dev": "nest start --watch",
    "build": "node ./scripts/with-root-env.mjs --allow-placeholder npx prisma generate && nest build",
    "start": "node dist/main.js",
    "prisma:generate": "node ./scripts/with-root-env.mjs --allow-placeholder npx prisma generate",
    "prisma:deploy": "node ./scripts/with-root-env.mjs npx prisma migrate deploy"
  },
  "dependencies": {
    "@karaoke/shared": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "@colyseus/schema": "^2.0.37",
    "colyseus": "^0.15.28",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.9.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.6.0",
    "typescript": "^5.6.3"
  }
}
